mqtt:
  broker: "[CHANGEME]"
  port: 1883
  username: "[CHANGEME]"
  password: "[CHANGEME]"

ups:
  name: "[CHANGEME]"
  friendly_name: "[CHANGEME]"
  poll_interval: 30
  # Required only if 'commands' below is used — a NUT user with INSTCMD
  # privileges for the commands you list (see upsd.users on the NUT server).
  upscmd_username: "[CHANGEME]"
  upscmd_password: "[CHANGEME]"

sensors:
  - key: "battery.charge"
    unit: "%"
    type: "sensor"
    icon: "mdi:battery"
    friendly_name: "Battery Charge"
    device_class: "battery"

  - key: "battery.charge.low"
    unit: "%"
    type: "sensor"
    icon: "mdi:gauge"
    friendly_name: "Battery Low Setpoint"
    entity_category: "diagnostic"

  - key: "battery.charge.warning"
    unit: "%"
    type: "sensor"
    icon: "mdi:gauge"
    friendly_name: "Battery Warning Setpoint"
    entity_category: "diagnostic"

  - key: "battery.runtime"
    unit: "s"
    type: "sensor"
    icon: "mdi:timer-sand"
    friendly_name: "Battery Runtime"
    device_class: "duration"
    entity_category: "diagnostic"

  - key: "battery.runtime.low"
    unit: "s"
    type: "sensor"
    icon: "mdi:timer-sand-empty"
    friendly_name: "Low Battery Runtime"
    device_class: "duration"
    entity_category: "diagnostic"

  - key: "battery.voltage"
    unit: "V"
    type: "sensor"
    icon: "mdi:flash"
    friendly_name: "Battery Voltage"
    device_class: "voltage"
    entity_category: "diagnostic"

  - key: "battery.voltage.nominal"
    unit: "V"
    type: "sensor"
    icon: "mdi:flash-outline"
    friendly_name: "Nominal Battery Voltage"
    device_class: "voltage"
    entity_category: "diagnostic"

  - key: "battery.type"
    type: "sensor"
    icon: "mdi:information"
    friendly_name: "Battery Chemistry"
    entity_category: "diagnostic"

  - key: "input.transfer.high"
    unit: "V"
    type: "sensor"
    icon: "mdi:flash-alert"
    friendly_name: "High Voltage Transfer"
    device_class: "voltage"
    entity_category: "diagnostic"

  - key: "input.transfer.low"
    unit: "V"
    type: "sensor"
    icon: "mdi:flash"
    friendly_name: "Low Voltage Transfer"
    device_class: "voltage"
    entity_category: "diagnostic"

  - key: "input.voltage"
    unit: "V"
    type: "sensor"
    icon: "mdi:flash"
    friendly_name: "Input Voltage"
    device_class: "voltage"

  - key: "input.voltage.nominal"
    unit: "V"
    type: "sensor"
    icon: "mdi:flash-outline"
    friendly_name: "Nominal Input Voltage"
    device_class: "voltage"
    entity_category: "diagnostic"

  - key: "output.voltage"
    unit: "V"
    type: "sensor"
    icon: "mdi:flash"
    friendly_name: "Output Voltage"
    device_class: "voltage"

  - key: "ups.load"
    unit: "%"
    type: "sensor"
    icon: "mdi:gauge"
    friendly_name: "Load"

  - key: "ups.realpower.nominal"
    unit: "W"
    type: "sensor"
    icon: "mdi:flash"
    friendly_name: "Nominal Real Power"
    device_class: "power"
    entity_category: "diagnostic"

  - key: "ups.beeper.status"
    type: "sensor"
    icon: "mdi:volume-high"
    friendly_name: "Beeper Status"
    entity_category: "diagnostic"

  - key: "ups.status"
    type: "sensor"
    icon: "mdi:power"
    friendly_name: "Status Data"

  - key: "ups.delay.shutdown"
    unit: "s"
    type: "sensor"
    icon: "mdi:timer-sand"
    friendly_name: "Load Shutdown Delay"
    device_class: "duration"
    entity_category: "diagnostic"

  - key: "ups.delay.start"
    unit: "s"
    type: "sensor"
    icon: "mdi:timer-sand"
    friendly_name: "Load Restart Delay"
    device_class: "duration"
    entity_category: "diagnostic"

  - key: "ups.timer.shutdown"
    unit: "s"
    type: "sensor"
    icon: "mdi:timer-stop-outline"
    friendly_name: "Load Shutdown Timer"
    device_class: "duration"
    entity_category: "diagnostic"

  - key: "ups.timer.start"
    unit: "s"
    type: "sensor"
    icon: "mdi:timer-play-outline"
    friendly_name: "Load Start Timer"
    device_class: "duration"
    entity_category: "diagnostic"

# Optional. Each entry publishes a Home Assistant button entity that runs the
# given NUT instant command (via `upscmd`) when pressed. Run `upscmd -l <ups>`
# to see which commands your UPS/driver supports.
commands:
  - key: "beeper.mute"
    icon: "mdi:volume-mute"
    friendly_name: "Mute Beeper"
    entity_category: "config"

  - key: "beeper.enable"
    icon: "mdi:volume-high"
    friendly_name: "Enable Beeper"
    entity_category: "config"

  - key: "test.battery.start.quick"
    icon: "mdi:battery-heart-variant"
    friendly_name: "Start Quick Battery Test"
    entity_category: "diagnostic"

  - key: "test.battery.stop"
    icon: "mdi:battery-heart-outline"
    friendly_name: "Stop Battery Test"
    entity_category: "diagnostic"
